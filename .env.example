# TMDB (free): https://www.themoviedb.org/settings/api  -> "API Key (v3 auth)"
VITE_TMDB_KEY=your_tmdb_v3_api_key

# Region for "where to watch" info (ISO country code)
VITE_REGION=PK

# Supabase (free): Project Settings -> API
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key
